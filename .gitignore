# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.*
!.env.example

# lockfiles from other package managers
package-lock.json
yarn.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/
# Agent worktrees: nested checkouts, never part of this one (tests, verify inputs).
.claude/worktrees/

# Playwright (#299)
/test-results/
/playwright-report/
/e2e/.auth/

# Local CLI keyring: agent keys for the local sandbox (pnpm ziki setup)
.ziki-cli/

# Saved test output. `pnpm verify:ready` and `pnpm test:cli` keep their logs
# in node_modules/.cache instead, outside the inputs they hash.
.test-output.txt
.verify-output.txt
